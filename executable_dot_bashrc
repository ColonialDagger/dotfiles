        mkdir -p "$@"
        cd "$@" || exit
}

smbadd() {
    local server="$1"
    local share="$2"

    if [ -z "$server" ] || [ -z "$share" ]; then
        echo "Usage: smbadd <server> <share>"
        return 1
    fi

    # Unit names must match the mount path
    local unit="media-${server}-${share}"

    # Mount unit
    local mount_unit="/etc/systemd/system/${unit}.mount"
    # Automount unit
    local automount_unit="/etc/systemd/system/${unit}.automount"
    # Override directory
    local override_dir="/etc/systemd/system/${unit}.mount.d"

    # Create mount unit
    sudo tee "$mount_unit" >/dev/null <<EOF
[Unit]
Description=SMB Mount for ${server}/${share}
After=network-online.target
Wants=network-online.target

[Mount]
What=//${server}/${share}
Where=/media/${server}/${share}
Type=cifs
Options=credentials=/etc/samba/creds,iocharset=utf8,_netdev,nofail
DirectoryMode=0755

[Install]
WantedBy=multi-user.target
EOF

    # Create automount unit
    sudo tee "$automount_unit" >/dev/null <<EOF
[Unit]
Description=Automount SMB Share ${server}/${share}

[Automount]
Where=/media/${server}/${share}

[Install]
WantedBy=multi-user.target
EOF

    # Create override directory
    sudo mkdir -p "$override_dir"

    # Override file (not strictly needed now, but useful for future expansion)
    sudo tee "${override_dir}/vars.conf" >/dev/null <<EOF
[Mount]
Environment="SERVER=${server}"
Environment="SHARE=${share}"
EOF

    # Reload systemd and enable automount
    sudo systemctl daemon-reload
    sudo systemctl enable --now "${unit}.automount"

    echo "Added SMB automount: /media/${server}/${share}"
}

smbremove() {
    local server="$1"
    local share="$2"

    if [ -z "$server" ] || [ -z "$share" ]; then
        echo "Usage: smbremove <server> <share>"
        return 1
    fi

    local unit="media-${server}-${share}"
    local mount_unit="/etc/systemd/system/${unit}.mount"
    local automount_unit="/etc/systemd/system/${unit}.automount"
    local override_dir="/etc/systemd/system/${unit}.mount.d"

    # Disable units
    sudo systemctl disable --now "${unit}.automount" 2>/dev/null
    sudo systemctl stop "${unit}.mount" 2>/dev/null

    # Remove unit files
    sudo rm -f "$mount_unit" "$automount_unit"
    sudo rm -rf "$override_dir"

    # Remove share directory
    sudo rm -rf "/media/${server}/${share}"

    # Remove server directory only if empty
    if [ -d "/media/${server}" ] && [ -z "$(ls -A "/media/${server}")" ]; then
        sudo rmdir "/media/${server}"
        echo "Removed empty server directory: /media/${server}"
    fi

    sudo systemctl daemon-reload
    echo "Removed SMB automount: /media/${server}/${share}"
}

