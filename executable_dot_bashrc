smbadd() {
    local server="$1"
    local share="$2"
    local creds="${3:-/etc/samba/creds}"
    local access="${4:-private}"

    if [ -z "$server" ] || [ -z "$share" ]; then
        echo "Usage: smbadd <server> <share> [credsfile] [private|public]"
        return 1
    fi

    # Normalize credentials path to absolute
    creds="${creds/#\~/$HOME}"
    if [[ "$creds" != /* ]]; then
        creds="$PWD/$creds"
    fi

    local unit="media-${server}-${share}"
    local mount_unit="/etc/systemd/system/${unit}.mount"
    local automount_unit="/etc/systemd/system/${unit}.automount"
    local override_dir="/etc/systemd/system/${unit}.mount.d"
    local mount_path="/media/${server}/${share}"

    # Base mount options
    local mount_opts="credentials=${creds},iocharset=utf8,_netdev,nofail"

    # Access mode logic
    if [ "$access" = "private" ]; then
        mount_opts+=",uid=$(id -u),gid=$(id -g),file_mode=0660,dir_mode=0770"
    elif [ "$access" = "public" ]; then
        mount_opts+=",file_mode=0666,dir_mode=0777"
    else
        echo "Invalid access mode. Use: private or public"
        return 1
    fi

    # Create mount unit
    sudo tee "$mount_unit" >/dev/null <<EOF
[Unit]
Description=SMB Mount for ${server}/${share}
After=network-online.target
Wants=network-online.target

[Mount]
What=//${server}/${share}
Where=${mount_path}
Type=cifs
Options=${mount_opts}
DirectoryMode=0755

[Install]
WantedBy=multi-user.target
EOF

    # Create automount unit
    sudo tee "$automount_unit" >/dev/null <<EOF
[Unit]
Description=Automount SMB Share ${server}/${share}

[Automount]
Where=${mount_path}

[Install]
WantedBy=multi-user.target
EOF

    # Override directory
    sudo mkdir -p "$override_dir"
    sudo tee "${override_dir}/vars.conf" >/dev/null <<EOF
[Mount]
Environment="SERVER=${server}"
Environment="SHARE=${share}"
EOF

    sudo systemctl daemon-reload
    sudo systemctl enable --now "${unit}.automount"

    # Local directory permissions
    sudo mkdir -p "/media/${server}"

    if [ "$access" = "private" ]; then
        sudo chown "$(id -u):$(id -g)" "$mount_path"
        sudo chmod 770 "$mount_path"
        echo "Share mounted as your user (private mode)"
    else
        sudo chown root:root "$mount_path"
        sudo chmod 777 "$mount_path"
        echo "Share is public and world-writable (public mode)"
    fi

    echo "Added SMB automount: ${mount_path}"
}

smbremove() {
    exit ## FIX THIS FUNC

    local server="$1"
    local share="$2"

    if [ -z "$server" ] || [ -z "$share" ]; then
        echo "Usage: smbremove <server> <share>"
        return 1
    fi

    local unit="media-${server}-${share}"
    local mount_unit="/etc/systemd/system/${unit}.mount"
    local automount_unit="/etc/systemd/system/${unit}.automount"
    local override_dir="/etc/systemd/system/${unit}.mount.d"
    local mount_path="/media/${server}/${share}"
    local group="smb-${server}-${share}"

    sudo systemctl disable --now "${unit}.automount" 2>/dev/null
    sudo systemctl stop "${unit}.mount" 2>/dev/null

    sudo rm -f "$mount_unit" "$automount_unit"
    sudo rm -rf "$override_dir"

    sudo rm -rf "$mount_path"

    if [ -d "/media/${server}" ] && [ -z "$(ls -A "/media/${server}")" ]; then
        sudo rmdir "/media/${server}"
        echo "Removed empty server directory: /media/${server}"
    fi

    sudo groupdel "$group" 2>/dev/null

    sudo systemctl daemon-reload
    echo "Removed SMB automount: ${mount_path}"
}

